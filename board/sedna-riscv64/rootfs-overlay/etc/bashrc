case $- in
    *i*) ;;
    *) return ;;
esac

shopt -s no_empty_cmd_completion
shopt -s histappend

if [ "$EUID" = 0 ]; then
    PS1='\[\033[01;31m\]\h\[\033[01;34m\] \w \$\[\033[00m\] '
else
    PS1='\[\033[01;32m\]\u@\h\[\033[01;34m\] \w \$\[\033[00m\] '
fi

for sh in /etc/bashrc.d/*; do
    [ -r "$sh" ] && . "$sh"
done
